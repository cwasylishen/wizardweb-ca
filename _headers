# WizardWeb.ca - Edge headers

# Favicon and logo SVGs: 30 days
/favicon.svg
  Cache-Control: public, max-age=2592000

# Images: 30 days
/assets/images/*
  Cache-Control: public, max-age=2592000

# Self-hosted fonts: immutable, 1 year
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: 1 hour, must-revalidate so updates show quickly
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: public, max-age=3600, must-revalidate

# CMS sandbox: keep out of search results, short cache
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: public, max-age=300

# Editor content seeds: not for search, not for visitors
/content/*
  X-Robots-Tag: noindex, nofollow

# Content-Security-Policy on the public pages only (admin keeps current behavior).
# Origins are exactly the ones in use: self, the app worker (forms, chat, beacon), Cal.com embed.
/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com https://cal.com; style-src 'self' 'unsafe-inline' https://app.cal.com; img-src 'self' data: https://app.cal.com https://cal.com; font-src 'self'; connect-src 'self' https://app.wizardweb.ca https://cal.com https://*.cal.com; frame-src https://cal.com https://app.cal.com; form-action 'self' https://app.wizardweb.ca; base-uri 'self'

/work
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com https://cal.com; style-src 'self' 'unsafe-inline' https://app.cal.com; img-src 'self' data: https://app.cal.com https://cal.com; font-src 'self'; connect-src 'self' https://app.wizardweb.ca https://cal.com https://*.cal.com; frame-src https://cal.com https://app.cal.com; form-action 'self' https://app.wizardweb.ca; base-uri 'self'

/work.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com https://cal.com; style-src 'self' 'unsafe-inline' https://app.cal.com; img-src 'self' data: https://app.cal.com https://cal.com; font-src 'self'; connect-src 'self' https://app.wizardweb.ca https://cal.com https://*.cal.com; frame-src https://cal.com https://app.cal.com; form-action 'self' https://app.wizardweb.ca; base-uri 'self'

/cr/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://app.wizardweb.ca; form-action 'self' https://app.wizardweb.ca; base-uri 'self'

# Security headers on every response
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
